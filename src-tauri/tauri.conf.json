{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Marker",
  "version": "0.1.0",
  "identifier": "de.ingaa.audio-marker",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Marker",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Music",
    "shortDescription": "Local audio playback with precise markers"
  }
}
